{
  "appId": "app.bravaburgers.repartidor",
  "appName": "Brava Repartidor",
  "webDir": "www",
  "server": {
    "url": "https://brava-burgers.vercel.app/repartidor/",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "appendUserAgent": "BravaRepartidorNative/1"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_notification",
      "iconColor": "#FF6B35"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
