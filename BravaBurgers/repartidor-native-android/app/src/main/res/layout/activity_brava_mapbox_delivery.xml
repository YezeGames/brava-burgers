<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141A">

    <com.mapbox.navigation.dropin.NavigationView
        android:id="@+id/bravaNavigationView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:accessToken="@string/mapbox_access_token" />

    <LinearLayout
        android:id="@+id/bravaManeuverCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/bravaManeuverPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/brava_nav_maneuver_primary_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bravaManeuverThen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/brava_nav_maneuver_sub_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="#B0BEC5"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/bravaNavSpeed"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:background="@drawable/brava_nav_speed_circle"
        android:gravity="center"
        android:lineSpacingExtra="-2dp"
        android:text="0\nkm/h"
        android:textAlignment="center"
        android:textColor="#1A2330"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/bravaMapControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/bravaBtnCompass"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/brava_nav_fab_circle"
            android:contentDescription="Brújula"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_brava_nav_compass" />

        <ImageButton
            android:id="@+id/bravaBtnVolume"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/brava_nav_fab_circle"
            android:contentDescription="Volumen"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_brava_nav_volume" />

        <ImageButton
            android:id="@+id/bravaBtnRecenter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/brava_nav_fab_circle"
            android:contentDescription="Centrar ubicación"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_brava_nav_recenter" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bravaBottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#F20B141A"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/bravaNavEta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="— min"
            android:textColor="#FF6B35"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bravaNavEtaClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/bravaNavAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

        <app.bravaburgers.repartidor.nativeapp.mapbox.BravaSwipeLlegueView
            android:id="@+id/bravaSwipeLlegue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</FrameLayout>
