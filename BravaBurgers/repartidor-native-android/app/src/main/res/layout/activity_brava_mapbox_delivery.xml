<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141A">

    <com.mapbox.navigation.dropin.NavigationView
        android:id="@+id/bravaNavigationView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:accessToken="@string/mapbox_access_token" />

    <LinearLayout
        android:id="@+id/bravaManeuverCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/brava_nav_maneuver_shell"
        android:elevation="18dp"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/bravaManeuverPrimaryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/brava_nav_maneuver_primary_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/brava_nav_maneuver_icon_bg">

                <ImageView
                    android:id="@+id/bravaManeuverPrimaryIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_brava_maneuver_turn_right" />
            </FrameLayout>

            <TextView
                android:id="@+id/bravaManeuverPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="2dp"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bravaManeuverThenRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/brava_nav_maneuver_sub_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/brava_nav_maneuver_icon_bg">

                <ImageView
                    android:id="@+id/bravaManeuverThenIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_brava_maneuver_turn_right" />
            </FrameLayout>

            <TextView
                android:id="@+id/bravaManeuverThen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="#E8EDF2"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/bravaNavSpeed"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="200dp"
        android:background="@drawable/brava_nav_orb_bg"
        android:elevation="12dp"
        android:gravity="center"
        android:lineSpacingExtra="-2dp"
        android:text="0\nkm/h"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/bravaMapControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="200dp"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/bravaBtnCompass"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/brava_nav_orb_bg"
            android:contentDescription="Brújula"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_brava_nav_compass" />

        <ImageButton
            android:id="@+id/bravaBtnVolume"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/brava_nav_orb_bg"
            android:contentDescription="Volumen"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_brava_nav_volume" />

        <ImageButton
            android:id="@+id/bravaBtnRecenter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/brava_nav_orb_bg"
            android:contentDescription="Centrar ubicación"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_brava_nav_recenter" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bravaBottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/brava_nav_bottom_bar"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <!-- Barra compacta tipo DiDi: min · km + llegada + chevron -->
        <LinearLayout
            android:id="@+id/bravaTripCollapsedBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bravaNavEta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="— min"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bravaNavEtaClock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp"
                    android:textColor="#B8C4CE"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/bravaBtnExpandPanel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mostrar llegada al cliente"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_brava_panel_chevron_up" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bravaBottomExpandSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/bravaNavAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:paddingBottom="10dp"
                android:textColor="#9CA3AF"
                android:textSize="14sp" />

            <app.bravaburgers.repartidor.nativeapp.mapbox.BravaSwipeButton
                android:id="@+id/bravaSwipeLlegue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="4dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
