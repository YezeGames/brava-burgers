<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bravaNavRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141A"
    android:fitsSystemWindows="false">

    <com.mapbox.maps.MapView
        android:id="@+id/bravaMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false" />

    <LinearLayout
        android:id="@+id/bravaManeuverCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/brava_nav_didi_maneuver_bg"
        android:elevation="20dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/bravaManeuverPrimaryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/bravaManeuverPrimaryIcon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_brava_maneuver_turn_right" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bravaManeuverDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bravaManeuverPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:textColor="#E8EDF2"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/bravaManeuverThen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/brava_nav_didi_maneuver_tab"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/bravaNavSpeed"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="200dp"
        android:background="@drawable/brava_nav_orb_bg"
        android:elevation="12dp"
        android:gravity="center"
        android:lineSpacingExtra="-2dp"
        android:text="0\nkm/h"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/bravaMapControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="200dp"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/bravaBtnCompass"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/brava_nav_orb_bg"
            android:contentDescription="Brújula"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_brava_nav_compass" />

        <ImageButton
            android:id="@+id/bravaBtnVolume"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/brava_nav_orb_bg"
            android:contentDescription="Volumen"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_brava_nav_volume" />

        <ImageButton
            android:id="@+id/bravaBtnRecenter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/brava_nav_orb_bg"
            android:contentDescription="Centrar ubicación"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_brava_nav_recenter" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bravaBottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/brava_nav_bottom_bar"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <!-- Barra compacta tipo DiDi: chevron izq + textos centrados + borde naranja -->
        <LinearLayout
            android:id="@+id/bravaTripCollapsedBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="10dp"
            android:paddingEnd="4dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/bravaBtnExpandPanel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mostrar llegada al cliente"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_brava_panel_chevron_up" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/bravaNavEta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="— min"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bravaNavEtaClock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="3dp"
                    android:textColor="#FF6B35"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/bravaNavAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:paddingTop="4dp"
                    android:textColor="#B8C4CE"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bravaBottomExpandSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <app.bravaburgers.repartidor.nativeapp.mapbox.BravaSwipeButton
                android:id="@+id/bravaSwipeLlegue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="4dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
