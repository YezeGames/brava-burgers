# Variables en Vercel → Settings → Environment Variables

# --- Tienda (pedidos desde Pedilo) ---
BRAVA_ORDER_SECRET=texto-largo-secreto
ADMIN_SESSION_SECRET=otro-texto-largo-para-sesion-admin

# --- Panel admin + pedidos en vivo (Supabase) — ver AYUDA_SUPABASE.md ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ADMIN_EMAIL=admin@brava.local
SUPABASE_ADMIN_PASSWORD=clave-del-usuario-auth-supabase
ADMIN_USER=admin
ADMIN_PASSWORD=clave-para-entrar-al-panel

# --- Opcional: menú / backup (sin Supabase el admin usa GAS) ---
# BRAVA_GAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# --- Mapas (demo ruta delivery / futuro admin) — Google Cloud: Maps JavaScript + Directions API ---
# GOOGLE_MAPS_API_KEY=AIza…  (restringir por HTTP referrer: brava-burgers.vercel.app/* y localhost)

# --- Mapbox (admin Reparto + autocompletado dirección tienda /api/address-suggest) ---
# MAPBOX_ACCESS_TOKEN=pk.…  (restringir URL a brava-burgers.vercel.app/* en el dashboard Mapbox)

