# Variables en Vercel → Settings → Environment Variables

# --- Tienda (pedidos web) ---
BRAVA_ORDER_SECRET=texto-largo-secreto
ADMIN_SESSION_SECRET=otro-texto-largo-para-sesion-admin

# --- Panel admin + pedidos en vivo (Supabase) — ver AYUDA_SUPABASE.md ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ADMIN_EMAIL=admin@brava.local
SUPABASE_ADMIN_PASSWORD=clave-del-usuario-auth-supabase
ADMIN_USER=admin
ADMIN_PASSWORD=clave-para-entrar-al-panel

# --- Opcional: menú / backup (sin Supabase el admin usa GAS) ---
# BRAVA_GAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# --- Mapas (autocompletado tienda + admin reparto) ---
# GOOGLE_MAPS_API_KEY=AIza…  (Places API + Geocoding; referrer: brava-burgers.vercel.app/*)
# Si está configurada, /api/address-suggest usa Google Maps; si no, Mapbox abajo.

# --- Mapbox (fallback autocompletado + admin Reparto) ---
# MAPBOX_ACCESS_TOKEN=pk.…  (restringir URL a brava-burgers.vercel.app/* en el dashboard Mapbox)

# --- WhatsApp Cloud API (Meta) — ver WHATSAPP_VERCEL_ENV.txt en raíz del repo ---
# WHATSAPP_VERIFY_TOKEN=texto-largo-igual-en-meta-webhook
# WHATSAPP_ACCESS_TOKEN=token-system-user-o-temporal
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WABA_ID=
# WHATSAPP_APP_SECRET=  (opcional; valida firma del webhook POST)
# WHATSAPP_GRAPH_VERSION=v22.0
# Callback URL Meta: https://brava-burgers.vercel.app/api/whatsapp-webhook
